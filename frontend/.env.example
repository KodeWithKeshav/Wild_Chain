# Which evidence store to use: kubo (local IPFS daemon) or memory (in-browser mock)
VITE_STORAGE=kubo
# Kubo HTTP API (upload) and public/local gateway (download)
VITE_IPFS_API=http://127.0.0.1:5001
VITE_IPFS_GATEWAY=http://127.0.0.1:8080
# Read-only RPC used before a wallet is connected (Ganache by default)
VITE_RPC_URL=http://127.0.0.1:7545
